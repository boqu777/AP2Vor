FUNCTION_BLOCK FB600
TITLE = 'Hardware_Ausgabe'
// =============================================================================
// Autor:         Boris Quade (66528)
// =============================================================================
// Library:       AP2_Basis
// Tested with:   CPU 314C-2 PN/DP
// Engineering:   Step7 V5.6
// Functionality: Weist die logischen Befehle (DB1.Cmd) den physikalischen 
//                Ausgängen zu und realisiert Hardware-Verriegelungen.
// -----------------------------------------------------------------------------
// Change log table:
// | Version | Date       |  Expert              |   Changes applied
// -----------------------------------------------------------------------------
// | 01.00.00| 05.12.2025 |  Boris Quade (66528) |   Erste Version
// -----------------------------------------------------------------------------
// | 01.01.00| 08.12.2025 |  Boris Quade (66528) |   -MM40 und Magnet entfernt
// =============================================================================
VERSION : '1.1'

VAR_TEMP
    // Hilfsvariable für bessere Lesbarkeit
    temp_BetriebAktiv : BOOL; 
END_VAR

BEGIN
    // Sammelstatus: Ausgänge dürfen nur aktiv sein, wenn Einricht- oder Automatikbetrieb aktiv ist.
    // Dies dient als globale Freigabe.
    temp_BetriebAktiv := DB1.Mode.Einrichten OR DB1.Mode.Automatik;

    // -------------------------------------------------------------------------
    // 1. X-Achse (Motor)
    // -------------------------------------------------------------------------
    // Logik: Befehl aktiv AND Gegensignal inaktiv (Verriegelung) AND Endschalter nicht belegt
    
    "-QA5" := DB1.Cmd.X_Achse_Links           // Befehl
              AND NOT DB1.Cmd.X_Achse_Rechts  // Software-Verriegelung
              AND NOT "-BG11"                 // Hardware-Endlage Links
              AND temp_BetriebAktiv;          // Allgemeine Freigabe

    "-QA6" := DB1.Cmd.X_Achse_Rechts 
              AND NOT DB1.Cmd.X_Achse_Links 
              AND NOT "-BG13"                 // Hardware-Endlage Rechts
              AND temp_BetriebAktiv;

    // -------------------------------------------------------------------------
    // 2. Pneumatik Zylinder MM20 (Magazin)
    // -------------------------------------------------------------------------
    // Hinweis: Bistabile Impulsventile benötigen gegenseitige Verriegelung
    
    "-MB21" := DB1.Cmd.MM20_Einfahren 
               AND NOT DB1.Cmd.MM20_Ausfahren 
               AND temp_BetriebAktiv;

    "-MB22" := DB1.Cmd.MM20_Ausfahren 
               AND NOT DB1.Cmd.MM20_Einfahren 
               AND temp_BetriebAktiv;

    // -------------------------------------------------------------------------
    // 3. Zylinder MM30 (Wippe)
    // -------------------------------------------------------------------------
    "-MB31" := DB1.Cmd.MM30_Einfahren 
               AND NOT DB1.Cmd.MM30_Ausfahren 
               AND temp_BetriebAktiv;

    "-MB32" := DB1.Cmd.MM30_Ausfahren 
               AND NOT DB1.Cmd.MM30_Einfahren 
               AND temp_BetriebAktiv;

    (*  Zylinder -MM40 und Magnet entfernt
    // -------------------------------------------------------------------------
    // 4. Zylinder MM40 (Magnet-Zylinder)
    // -------------------------------------------------------------------------
    "-MB41" := DB1.Cmd.MM40_Einfahren 
               AND NOT DB1.Cmd.MM40_Ausfahren 
               AND temp_BetriebAktiv;

    "-MB42" := DB1.Cmd.MM40_Ausfahren 
               AND NOT DB1.Cmd.MM40_Einfahren 
               AND temp_BetriebAktiv;
    *)
END_FUNCTION_BLOCK