FUNCTION_BLOCK FB200
TITLE = 'Anzeige'
// =============================================================================
// Autor:        Boris Quade (66528)
// =============================================================================
// Library:       AP2_Basis
// Tested with:   CPU 314C-2 PN/DP
// Engineering:   Step7 V5.6
// Restrictions:  Benötigt DB1 (Status/Mode) und DB2 (Positionen)
// Functionality: Steuerung der Meldeleuchten (PF...) basierend auf dem 
//                Anlagenstatus im DB1.
//                - Betriebsartenanzeige (Dauerlicht/Blinken)
//                - Fehleranzeige
//                - Positionsmeldung
// Change log table:
// | Version | Date       |  Expert              |   Changes applied
// -----------------------------------------------------------------------------
// | 01.00.00| 05.12.2025 |  Boris Quade (66528) |   Erste Version
// -----------------------------------------------------------------------------
// | 01.01.00| 08.12.2025 |  Boris Quade (66528) | -PF5 -PF14 -PF33, -PF2 angepasst
// =============================================================================
VERSION : '1.1'

BEGIN
    // -------------------------------------------------------------------------
    // 1. Sicherheits-Check (Guard Clause)
    // -------------------------------------------------------------------------
    // Wenn die Anlage nicht bereit ist (Not-Halt, Druckfehler, etc.),
    // werden alle Meldeleuchten ausgeschaltet (oder spezifisch behandelt).
    IF NOT DB1.Status.Anlage_Bereit THEN
        "-PF2"  := FALSE; 
        "-PF3"  := FALSE; 
        "-PF4"  := FALSE; 
        "-PF5"  := FALSE;
        "-PF6"  := FALSE; 
        "-PF7"  := FALSE; 
        "-PF8"  := FALSE; 
        "-PF32" := FALSE; 
        "-PF33" := FALSE;
        
        // Baustein hier verlassen, keine weitere Bearbeitung
        RETURN;
    END_IF;

    // -------------------------------------------------------------------------
    // 2. Statusanzeigen (Allgemein)
    // -------------------------------------------------------------------------
    
    // PF2: Grundstellung
    // Leuchtet, wenn alle Zylinder in Grundstellung sind und Magnet an ist.
    "-PF2" := "-BG13" AND "-BG21" AND "-BG31";

    // PF3: Betriebsart
    // Einrichtbetrieb = Dauerlicht
    // Automatikbetrieb = Blinken (1Hz Takt aus DB1)
    IF DB1.Mode.Einrichten THEN
        "-PF3" := TRUE;
    ELSIF DB1.Mode.Automatik THEN
        "-PF3" := DB1.Status.Takt_1Hz;
    ELSE
        "-PF3" := FALSE;
    END_IF;

    // PF4: Betriebsdruck
    // Leuchtet, wenn Druckwächter -BP1 aktiv ist.
    "-PF4" := "-BP1";

    // PF5: Nicht in Gebrauch (Reservelampe)
    // "-PF5" := NOT "-FC7";

    // -------------------------------------------------------------------------
    // 3. Bewegungsanzeigen
    // -------------------------------------------------------------------------
    
    // PF6: Linksfahrt (blinkend während der Fahrt)
    "-PF6" := ("-QA5" AND DB1.Status.Takt_1Hz);

    // PF7: Rechtsfahrt (blinkend während der Fahrt)
    "-PF7" := ("-QA6" AND DB1.Status.Takt_1Hz);

    // -------------------------------------------------------------------------
    // 4. Positionsanzeigen
    // -------------------------------------------------------------------------
    
    // PF8: Position erreicht
    // Leuchtet, wenn die Ist-Position einer der definierten Soll-Positionen 
    // aus DB2 entspricht.
    "-PF8" := (DB1.Status.IstPosition = DB2.Pos1) OR 
              (DB1.Status.IstPosition = DB2.Pos2) OR 
              (DB1.Status.IstPosition = DB2.Pos3) OR 
              (DB1.Status.IstPosition = DB2.Pos4);

    // -------------------------------------------------------------------------
    // 5. Zylinderstatus (Direktanzeige Sensoren)
    // -------------------------------------------------------------------------
    "-PF10" := "-BG21"; // MM20 eingefahren
    "-PF11" := "-BG22"; // MM20 ausgefahren
    "-PF12" := "-BG31"; // MM30 eingefahren (Wippe)
    //"-PF14" := "-BG41"; // MM40 eingefahren (Magnetzylinder) // Nicht in Gebrauch

    // -------------------------------------------------------------------------
    // 6. Prozessstatus
    // -------------------------------------------------------------------------
    
    // PF32: Magazin leer
    // Leuchtet, wenn keine Teileerkennung aktiv ist
    "-PF32" := (NOT "-BG51" AND "-BG52"); 

    // PF33: Nicht in Gebrauch (Reservelampe)
    //"-PF33" := "-QA61";

END_FUNCTION_BLOCK
