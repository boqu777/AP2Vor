FUNCTION_BLOCK FB500
TITLE = 'Automatikbetrieb'
// =============================================================================
// Autor:          Boris Quade (66528)
// =============================================================================
// Library:        AP2_Basis
// Tested with:    CPU 314C-2 PN/DP
// Engineering:    Step7 V5.6
// Functionality:  Schrittkette (Sequencer) für den automatischen Prozessablauf.
//                 Der Baustein steuert die Sortieranlage basierend auf Materialerkennung.
//
//                 Ablauflogik:
//                 1. Start in Grundstellung
//                 2. Erkennung (Metall/Kunststoff/Metall mit Bohrung)
//                 3. Positionierung der X-Achse an Ablageposition
//                 4. Auswurf des Werkstücks
//                 5. Ggf. Weitertransport oder Quittierung
// -----------------------------------------------------------------------------
// Change log table:
// | Version | Date       |  Expert               |   Changes applied
// -----------------------------------------------------------------------------
// | 01.00.00| 05.12.2025 |  Boris Quade (66528)  |   Erste Version
// -----------------------------------------------------------------------------
// | 01.01.00| 08.12.2025 |  Boris Quade (66528)  |   -SJ12 Quittierung ergänzt 
// |         |            |                       |   -MM40 und Magnet entfernt
// -----------------------------------------------------------------------------
// | 01.02.00| 08.12.2025 |  Boris Quade (66528)  |   Timer-Fix: Instanzen separiert
// |         |            |                       |   und zentraler Reset eingefügt.
// | 01.03.00| 24.01.2026 |  Boris Quade (66528)  |   OZB / MZB Erkennung 507a/b/c
// |         |            |                       |   und -BG53 als Pos2 Sensor
// =============================================================================
VERSION : '1.3'

VAR
    // =========================================================================
    // Statische Variablen (Gedächtnis des FBs)
    // =========================================================================
    statSchritt     : INT := 500;       // Speichert die aktuelle Schrittnummer (Startwert 500)
    statSchritt_Alt : INT;              // Hilfsvariable zur Schritt Flankenerkennung (Altwert)
    statSollPos     : INT;              // Speichert die Zielposition (Impulse) für die X-Achse
    statsSJ12_Alt   : BOOL;             // Flankenmerker für den Taster -SJ12 (Quittierung)

    // =========================================================================
    // Timer Instanzen (IEC-Timer TON = SFB4)
    // Pro Schritt/Funktion eine eigene Instanz, um Überschneidungen zu vermeiden.
    // =========================================================================
    instT_S504_Ausfahren : TON; // Verzögerung, bevor MM20 ausfährt (Schritt 504)
    instT_S504_Endlage   : TON; // Wartezeit Endlage "Ausgefahren" (Schritt 504)
    instT_S505_Endlage   : TON; // Wartezeit Endlage "Eingefahren" (Schritt 505)
    instT_S507_Abwurf    : TON; // Zeit, die die Wippe offen bleibt (Schritt 507)
    instT_S508_Zu        : TON; // Zeit zum Schließen der Wippe (Schritt 508)
    instT_S507a_ozb      : TON; // 3s -MB42 und -BG42 nicht =>OZB
    instT_S507a_mzb      : TON; // -BG42 fuer 2 Sekunden => MZB
    instT_S507d_Zu       : TON; // -BG41 fuer 2 Sekunden (MM40 wieder eingefahren)
END_VAR

VAR_TEMP
    // =========================================================================
    // Temporäre Variablen (Nur für einen Zyklus gültig)
    // =========================================================================
    tempSchrittInit : BOOL; // Ist genau EINEN Zyklus lang TRUE, wenn ein neuer Schritt beginnt.
    tempSJ12Ris     : BOOL; // Steigende Flanke von Taster -SJ12
END_VAR

BEGIN
    // #########################################################################
    // TEIL 1: Allg. Vorbedingungen und Reset
    // #########################################################################

    // -------------------------------------------------------------------------
    // Not-Aus / Betriebsarten-Check
    // -------------------------------------------------------------------------
    // Wenn die Automatik nicht angewählt ist (z.B. Handbetrieb oder Not-Aus),
    // wird die Schrittkette sofort zurückgesetzt.
    IF NOT DB1.Mode.Automatik THEN
        statSchritt := 500; // Zurück in Startschritt
        
        // WICHTIG: Alle Timer resetten (IN:=FALSE), damit sie beim nächsten Start bei 0 beginnen.
        instT_S504_Ausfahren(IN:=FALSE, PT:=T#0ms);
        instT_S504_Endlage(IN:=FALSE, PT:=T#0ms);
        instT_S505_Endlage(IN:=FALSE, PT:=T#0ms);
        instT_S507_Abwurf(IN:=FALSE, PT:=T#0ms);
        instT_S508_Zu(IN:=FALSE, PT:=T#0ms);
        instT_S507a_ozb(IN:=FALSE, PT:=T#0ms);
        instT_S507a_mzb(IN:=FALSE, PT:=T#0ms);
        instT_S507d_Zu(IN:=FALSE, PT:=T#0ms);
        
        RETURN; // Baustein hier verlassen, Rest des Codes wird ignoriert.
    END_IF;

    // -------------------------------------------------------------------------
    // Initialisierung & Flankenerkennung
    // -------------------------------------------------------------------------
    // Prüfung: Hat sich der Schritt seit dem letzten Zyklus geändert?
    tempSchrittInit := (statSchritt <> statSchritt_Alt);
    statSchritt_Alt := statSchritt; // Aktuellen Schritt für nächsten Zyklus merken

    // ZENTRALER TIMER RESET
    // Bei jedem Eintritt in einen neuen Schritt (tempSchrittInit = TRUE) werden 
    // vorsorglich alle Sequenz-Timer zurückgesetzt.
    IF tempSchrittInit THEN
        instT_S504_Ausfahren(IN:=FALSE, PT:=T#0ms);
        instT_S504_Endlage(IN:=FALSE, PT:=T#0ms);
        instT_S505_Endlage(IN:=FALSE, PT:=T#0ms);
        instT_S507_Abwurf(IN:=FALSE, PT:=T#0ms);
        instT_S508_Zu(IN:=FALSE, PT:=T#0ms);
        instT_S507a_ozb(IN:=FALSE, PT:=T#0ms);
        instT_S507a_mzb(IN:=FALSE, PT:=T#0ms);
        instT_S507d_Zu(IN:=FALSE, PT:=T#0ms);
    END_IF;

    // Flankenerkennung für Quittiertaster -SJ12
    tempSJ12Ris := ("-SJ12" <> statsSJ12_Alt); // Ist Zustand jetzt anders als vorher?
    statsSJ12_Alt := "-SJ12";                  // Zustand merken

    // #########################################################################
    // TEIL 2: Aktor-Ansteuerung (Initialisierung)
    // #########################################################################
    // "Befehls-Reset": Alle Ausgänge werden standardmäßig auf FALSE gesetzt.
    // Nur im aktiven Schritt (CASE) werden sie gezielt auf TRUE gesetzt.
    // Dies verhindert, dass Aktoren ungewollt an bleiben ("Hängenbleiben").
    DB1.Cmd.X_Achse_Links     := FALSE;
    DB1.Cmd.X_Achse_Rechts    := FALSE;
    DB1.Cmd.MM20_Einfahren    := FALSE;
    DB1.Cmd.MM20_Ausfahren    := FALSE;
    DB1.Cmd.MM30_Einfahren    := FALSE;
    DB1.Cmd.MM30_Ausfahren    := FALSE;

    // #########################################################################
    // TEIL 3: Schrittkette (Sequencer)
    // #########################################################################
    CASE statSchritt OF
        
        // ---------------------------------------------------------------------
        // Schritt 500: Grundstellung & Startbedingung
        // ---------------------------------------------------------------------
        500: 
            // Aktoren aktiv in Grundstellung zwingen (Sicherheit)
            // Zylinder fahren ein, solange Endlage nicht erreicht ist.
            DB1.Cmd.MM20_Einfahren := NOT "-BG21"; // Zyl. Magazin einfahren
            DB1.Cmd.MM30_Einfahren := NOT "-BG31"; // Wippe schließen
            DB1.Cmd.X_Achse_Rechts := NOT "-BG13"; // Achse nach rechts (Referenz)

            // TRANSITION (Weiterschaltbedingung):
            // 1. Starttaster (-SJ5) gedrückt
            // 2. Alle Aktoren in Grundstellung (-BG13, -BG21, -BG31)
            // 3. Teil im Magazin vorhanden (-BG51 ODER -BG52 aktiv)
            IF "-SJ5" AND "-BG13" AND "-BG21" AND "-BG31" AND ("-BG51" OR NOT "-BG52") THEN
                statSchritt := 501; // Weiter zu Analyse
            END_IF;

        // ---------------------------------------------------------------------
        // Schritt 501: Materialerkennung & Zielwahl
        // ---------------------------------------------------------------------
        501: 
            // Hier wird die Ziel Ablagepostion entschieden, basierend auf den Sensoren.
            
            // FALL 1: Metall MIT Bohrung (Induktiv=1, Lichtschranke=1) -> Pos 2
            IF ("-BG51" AND "-BG52") THEN
                statSollPos := DB2.Pos2; 
                statSchritt := 503;
            
            // FALL 2: Kunststoff (Induktiv=0, Lichtschranke=0) -> Pos 1
            // Hinweis: Induktiv reagiert nicht auf Kunststoff,
            // Lichtschranke wird unterbrochen
            ELSIF (NOT "-BG51" AND NOT "-BG52") THEN
                statSollPos := DB2.Pos1;
                statSchritt := 503;
            
            // FALL 3: Metall OHNE Bohrung (Induktiv=1, Lichtschranke=0) -> Pos 3
            ELSIF ("-BG51" AND NOT "-BG52") THEN
                statSollPos := DB2.Pos3; 
                statSchritt := 503;
            END_IF;

        // ---------------------------------------------------------------------
        // Schritt 503: Positionierung (Fahrt zum Ziel)
        // ---------------------------------------------------------------------
        503: 
            // Fahrbefehl ausgeben
            DB1.Cmd.X_Achse_Links := TRUE;
            
            // TRANSITION: Ist-Position im DB1 entspricht der Soll-Position
            IF DB1.Status.IstPosition = statSollPos THEN
                statSchritt := 504; // Position erreicht -> Auswerfen
            END_IF;

        // ---------------------------------------------------------------------
        // Schritt 504: Werkstück aus Magazin schieben
        // ---------------------------------------------------------------------
        504: 
            // 1. Wartezeit (1s) bevor Zylinder losfährt (Stabilisierung)
            instT_S504_Ausfahren(IN := TRUE, PT := T#1s);
            
            IF instT_S504_Ausfahren.Q THEN
                DB1.Cmd.MM20_Ausfahren := TRUE; // Zylinder MM20 vor
            END_IF;
            
            // 2. Warten, bis Zylinder ganz draußen ist (-BG22) UND 1s gehalten hat
            instT_S504_Endlage(IN := "-BG22", PT := T#1s);
            
            // TRANSITION
            IF "-BG22" AND instT_S504_Endlage.Q THEN
                statSchritt := 505; 
            END_IF;

        // ---------------------------------------------------------------------
        // Schritt 505: Ausschieber einfahren (Reset MM20)
        // ---------------------------------------------------------------------
        505: 
            DB1.Cmd.MM20_Einfahren := TRUE; // Zylinder zurück
            
            // TRANSITION: Warten auf Endlage eingefahren (-BG21) + 5s Pause
            instT_S505_Endlage(IN := "-BG21", PT := T#5s);
            
            IF instT_S505_Endlage.Q THEN
                 statSchritt := 506; // Weiter zur Verzweigung
            END_IF;

        // ---------------------------------------------------------------------
        // Schritt 506: Logische Verzweigung nach Auswurf
        // ---------------------------------------------------------------------
        // Je nachdem, wo wir gerade sind (statSollPos), passiert etwas anderes.
        506: 
            // Pos 1 (Kunststoff): Muss abgeworfen werden -> Wippe öffnen
            IF (statSollPos = DB2.Pos1) THEN
                statSchritt := 507; 

            // Pos 2 (Metall m. Bohrung): Wird auf Zentrierbohrung geprüft
            ELSIF (statSollPos = DB2.Pos2) AND "-BG53" THEN // Teil auf Pos2 erkannt
                statSchritt := 517; // Sprung zur Prüfung auf OZB / MZB

            // Pos 3 (Metall o. Bohrung): Fertig -> Rückfahrt
            ELSIF (statSollPos = DB2.Pos3) THEN
                statSchritt := 509; 
            END_IF;

        // ---------------------------------------------------------------------
        // Schritt 507: Abwurf (Nur bei Kunststoff)
        // ---------------------------------------------------------------------
        507: 
            DB1.Cmd.MM30_Ausfahren := TRUE; // Wippe auf
            
            // TRANSITION: Warten bis Wippe 2s lang offen war (-BG32)
            instT_S507_Abwurf(IN := "-BG32", PT := T#2s);
            IF instT_S507_Abwurf.Q THEN
                statSchritt := 508; 
            END_IF;

        // ---------------------------------------------------------------------
        // Schritt 508: Wippe schließen
        // ---------------------------------------------------------------------
        508: 
            DB1.Cmd.MM30_Einfahren := TRUE; // Wippe zu
            
            // TRANSITION: Warten bis Wippe sicher zu ist (-BG31) + 1s
            instT_S508_Zu(IN := "-BG31", PT := T#1s);
            IF instT_S508_Zu.Q THEN
                statSchritt := 509; // Fertig -> Rückfahrt
            END_IF;

        // ---------------------------------------------------------------------
        // Schritt 507a/b/c (Intern Schritt 517): Erkennung ob Teil mit oder ohne
        // Zentrierbohrung auf Pos.2 liegt. (OZB / MZB)
        // ---------------------------------------------------------------------
        517:
            // Anlage wartet hier. Keine Ausgänge werden gesetzt.
            // Der Bediener entnimmt das Teil und drückt -SJ12.
            DB1.Cmd.MM40_Ausfahren := TRUE; // Pruefdornzylinder ausfahren
            instT_S507a_mzb(IN := "-BG42", PT := T#2s)
            instT_S507a_ozb(IN := TRUE, PT := T#3s);
            IF instT_S507a_ozb.Q AND NOT "-BG42" THEN // 3s -MB42 und -BG42 nicht
                  DB1.Status.OZB := TRUE; // OZB melden
            ELSIF instT_S507a_mzb.Q AND "-BG42" THEN // -BG42 fuer 2 Sekunden
                  DB1.Status.MZB := TRUE; // MZB melden
            END_IF;
            // TRANSITION: OZB oder MZB erkannt
            IF DB1.Status.OZB OR DB1.Status.MZB THEN
                statSchritt := 518; // 507d Wieder einfahren und auf Quittierung warten
            END_IF;
        // ---------------------------------------------------------------------
        // Schritt 507d (Intern Schritt 518): Prüfdornzylinder wieder einfahren
        // und auf Quittierung warten 
        // ---------------------------------------------------------------------
        518:
            DB1.Cmd.MM40_Einfahren := TRUE; // Pruefdornzylinder einfahren
            instT_S507d_Zu(IN:="-BG41", PT:=T#2s) // 2s eingefahren

            // TRANSITION: Positive Flanke Quittiertaster -SJ12 und
            // Pruefdornzylinder fuer 2s eingefahren
            IF tempSJ12Ris and instT_S507d_Zu.Q THEN
                statSchritt := 509; // Fertig -> Rückfahrt
            END_IF;   
        
        // ---------------------------------------------------------------------
        // Schritt 509: Rücksetzen der OZB / MZB Signale
        // ---------------------------------------------------------------------
        509: 
                DB1.Status.OZB := FALSE; // OZB zurücksetzen
                DB1.Status.MZB := FALSE; // MZB zurücksetzen    
                statSchritt := 510; // Weiter zur Rückfahrt

        // ---------------------------------------------------------------------
        // Schritt 509: Rückfahrt zur Referenz
        // ---------------------------------------------------------------------
        510: 
            DB1.Cmd.X_Achse_Rechts := TRUE; // Fahre nach Rechts
            
            // TRANSITION: Referenzschalter (-BG13) erreicht
            IF "-BG13" THEN
                statSchritt := 511;
            END_IF;

        // ---------------------------------------------------------------------
        // Schritt 511: Zyklus-Ende Check
        // ---------------------------------------------------------------------
        511: 
             // FALL 1: Magazin leer (Kein Teil mehr erkannt)
             // Anlage geht in Grundstellung (500) und wartet auf neuen Start.
             IF ("-BG21" AND NOT "-BG51" AND "-BG52") THEN
                 statSchritt := 500; 
             
             // FALL 2: Noch Teile vorhanden
             // Direkter Neustart des Zyklus (Dauerlauf) -> Zurück zu Schritt 501
             ELSIF ("-BG21" AND ("-BG51" OR NOT "-BG52")) THEN
                 statSchritt := 501;
             END_IF;

        // ---------------------------------------------------------------------
        // Fehlerbehandlung
        // ---------------------------------------------------------------------
        ELSE
            // Sollte die Schrittvariable einen ungültigen Wert haben, 
            // wird hier ein sicherer Reset durchgeführt.
            statSchritt := 500;
            
    END_CASE;

END_FUNCTION_BLOCK